# --------------------------------------------------------------------------
# .env.example — copialo a .env y completá los valores para correr local
# --------------------------------------------------------------------------
# El archivo .env NUNCA va a git (está en .gitignore).
# En Render, estas variables se setean en el dashboard del service.

# ----- Django -----
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=

# ----- Database -----
# Para dev local NO hace falta setear DATABASE_URL: cae al sqlite del repo.
# Para apuntar a Neon (postgres):
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Para conectarse al MySQL de PythonAnywhere durante la migración:
#   DATABASE_URL=mysql://user:pass@host:3306/dbname
DATABASE_URL=

# ----- Google Sheets sync -----
# Ruta al JSON del service account. Si está fuera del repo, usá la ruta absoluta.
GOOGLE_CREDENTIALS_PATH=/Users/<tu-user>/credentials-backup/golosinas-insa-credentials.json
GOOGLE_SHEET_ID=1Zv9TDVJRDG_Ar-U4qTvlTcTiJ7RUpZnawxGwPpL4IZI
GOOGLE_SHEET_RANGE=articulos!A1:Z1500
