# --------------------------------------------------------------------------
# .env.staging.example — template para Neon STAGING
# --------------------------------------------------------------------------
# Copialo a .env.staging y completá con la URL real de Neon.
# El archivo .env.staging NUNCA va a git (está en .gitignore).
#
# Lo usan los scripts:
#   ./scripts/load-data.sh staging <dump.json>
#   ./scripts/copy-local-to-neon.sh staging
#
# DÓNDE OBTENER LA URL:
#   1. Neon Console → tu proyecto VentaStockManager
#   2. Selector de branch arriba → elegí "staging"
#   3. "Connection Details" o "Dashboard"
#   4. IMPORTANTE: elegí "Direct connection" (NO "Pooled connection")
#      - Pooler URL tiene "-pooler" en el host → mala para operaciones largas
#      - Direct URL no tiene "-pooler" → buena para migraciones y dumps
#   5. Copiá la URL completa
#
# Ejemplo del formato (con password ficticia y host ficticio):
#   postgresql://neondb_owner:npg_XXXXXXXXX@ep-empty-grass-ap0z074m.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# IMPORTANTE: usá COMILLAS SIMPLES ('...') no dobles, porque la URL
# tiene '&' y otros caracteres que el shell interpreta de forma rara
# entre comillas dobles.

NEON_URL='postgresql://neondb_owner:<PASSWORD>@<host-direct>.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
