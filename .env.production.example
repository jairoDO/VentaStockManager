# --------------------------------------------------------------------------
# .env.production.example — template para Neon PRODUCTION
# --------------------------------------------------------------------------
# Copialo a .env.production y completá con la URL real de Neon.
# El archivo .env.production NUNCA va a git (está en .gitignore).
#
# Lo usan los scripts:
#   ./scripts/load-data.sh production <dump.json>
#   ./scripts/copy-local-to-neon.sh production
#
# DÓNDE OBTENER LA URL:
#   1. Neon Console → tu proyecto VentaStockManager
#   2. Selector de branch arriba → elegí "production" (o "main", según
#      como lo hayas llamado en Neon — debe ser la branch de PROD, no staging)
#   3. "Connection Details" o "Dashboard"
#   4. IMPORTANTE: elegí "Direct connection" (NO "Pooled connection")
#      - Pooler URL tiene "-pooler" en el host → mala para operaciones largas
#      - Direct URL no tiene "-pooler" → buena para migraciones y dumps
#   5. Copiá la URL completa
#
# ⚠️  PRECAUCIÓN: esta URL apunta a PRODUCCIÓN. Cualquier comando que
# corras con este .env afecta los datos reales del cliente. Tené cuidado
# especialmente con scripts que TRUNCAN tablas (como copy-local-to-neon.sh).
#
# Ejemplo del formato (con password ficticia y host ficticio):
#   postgresql://neondb_owner:npg_XXXXXXXXX@ep-XXXX-prod.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# IMPORTANTE: usá COMILLAS SIMPLES ('...') no dobles.

NEON_URL='postgresql://neondb_owner:<PASSWORD>@<host-direct>.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
